# Which sandbox this MCP server drives. Defaults to the live Online v1.1
# sandbox (autopay-sandbox/) already deployed at sndbx.autopaylab.com.
AUTOPAY_SANDBOX_URL=https://sndbx.autopaylab.com

# Optional. Unset = server is open to anyone (today's demo default). Set a
# random secret here and in Vercel's project settings to require every
# client to send "Authorization: Bearer <this value>".
MCP_ACCESS_TOKEN=
