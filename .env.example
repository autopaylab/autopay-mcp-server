# Autopay test credentials. Defaults (ServiceID "2" / shared key "2test2")
# are the documentation's own worked-example values, used so the hash math
# is verifiable against the docs. They will NOT authenticate against a real
# Autopay test environment. Replace with real values once Autopay issues a
# dedicated test ServiceID + shared key during integration onboarding.
AUTOPAY_SERVICE_ID=2
AUTOPAY_SHARED_KEY=2test2
AUTOPAY_HASH_ALGO=sha256

# Confirmed by the docs.
AUTOPAY_GATEWAY_HOST=https://testpay.autopay.eu

# Online v1.1: exact test form URL is partner-specific ("Adres testowego
# formularza"), handed out by Autopay during test-environment onboarding.
# Leave empty to get a dry-run result (signed fields, no live request sent).
AUTOPAY_GATEWAY_URL=

# WhiteLabel: "{host_bramki}" the docs refer to — also partner-specific.
# Leave empty to get a dry-run result for gatewayList/legalData/payment.
AUTOPAY_WHITELABEL_HOST=

# Optional. Unset = server is open to anyone (today's demo default). Set a
# random secret here and in Vercel's project settings to require every
# client to send "Authorization: Bearer <this value>" on POST /api/mcp.
MCP_ACCESS_TOKEN=

# Local dev server port (scripts/dev-server.js only).
PORT=3002
